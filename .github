name: CI - train & build

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  train-build:
    runs-on: ubuntu-latest
    env:
      PYTHONUNBUFFERED: 1

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: Install system deps
        run: sudo apt-get update && sudo apt-get install -y unzip curl

      - name: Install Python deps
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Download dataset
        env:
          DATA_URL: ${{ secrets.DATA_URL }}
        run: |
          chmod +x ./download_data.sh
          ./download_data.sh

      - name: Train model
        run: python train.py

      - name: Run tests
        run: pytest -q

      - name: Build Docker image
        run: |
          IMAGE=ghcr.io/${{ github.repository_owner }}/${{ github.event.repository.name }}:latest
          docker build -t $IMAGE .

      - name: Login to GHCR
        if: ${{ secrets.GHCR_TOKEN != '' }}
        env:
          CR_PAT: ${{ secrets.GHCR_TOKEN }}
        run: echo $CR_PAT | docker login ghcr.io -u ${{ github.actor }} --password-stdin

      - name: Push image to GHCR
        if: ${{ secrets.GHCR_TOKEN != '' }}
        run: |
          IMAGE=ghcr.io/${{ github.repository_owner }}/${{ github.event.repository.name }}:latest
          docker push $IMAGE
